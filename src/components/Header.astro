---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const navigation = [
	{ label: 'Home', href: base || '/' },
	{ label: 'Research', href: `${base}/research` },
	{ label: 'People', href: `${base}/people` },
	{ label: 'Publications', href: `${base}/publications` },
	{ label: 'Join Us', href: `${base}/join-us` },
];

const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
---

<header class="site-header">
	<div class="header-inner">
		<a class="wordmark" href={base} aria-label="Gupta Research Group home">Gupta Research Group</a>

		<nav class="desktop-nav" aria-label="Primary navigation">
			<ul>
				{navigation.map((item) => (
					<li><a href={item.href} aria-current={currentPath === normalizePath(item.href) ? 'page' : undefined}>{item.label}</a></li>
				))}
			</ul>
			<a class="ucf-link" href="https://www.ucf.edu/" target="_blank" rel="noopener noreferrer">UCF</a>
		</nav>

		<details class="mobile-nav">
			<summary aria-label="Toggle navigation"><span>Menu</span></summary>
			<nav aria-label="Mobile navigation">
				{navigation.map((item) => (
					<a href={item.href} aria-current={currentPath === normalizePath(item.href) ? 'page' : undefined}>{item.label}</a>
				))}
				<a class="mobile-ucf" href="https://www.ucf.edu/" target="_blank" rel="noopener noreferrer">UCF</a>
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 1000;
		border-bottom: 1px solid #e6e7e9;
		background: #fff;
		box-shadow: 0 2px 12px rgb(0 0 0 / 4%);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 64px, 1440px);
		height: 80px;
		margin-inline: auto;
	}

	.wordmark {
		font-size: 1.4rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		text-decoration: none;
	}

	.desktop-nav,
	.desktop-nav ul {
		display: flex;
		align-items: center;
	}

	.desktop-nav ul {
		gap: clamp(24px, 2.35vw, 40px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.desktop-nav a {
		font-size: 0.88rem;
		font-weight: 450;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.desktop-nav a:hover,
	.desktop-nav a:focus-visible,
	.desktop-nav a[aria-current='page'] {
		color: #8a6300;
	}

	.ucf-link {
		margin-left: clamp(30px, 3.4vw, 56px);
		padding-left: clamp(30px, 3.4vw, 56px);
		border-left: 1px solid #dedfe2;
		font-weight: 760 !important;
		letter-spacing: 0.08em;
	}

	.mobile-nav {
		display: none;
	}

	@media (max-width: 800px) {
		.wordmark {
			font-size: 1.15rem;
		}

		.header-inner {
			width: min(100% - 40px, 1440px);
			height: 70px;
		}

		.desktop-nav {
			display: none;
		}

		.mobile-nav {
			display: block;
		}

		.mobile-nav summary {
			cursor: pointer;
			list-style: none;
			font-size: 0.82rem;
			font-weight: 650;
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		.mobile-nav summary::-webkit-details-marker {
			display: none;
		}

		.mobile-nav summary::after {
			content: '+';
			display: inline-block;
			margin-left: 8px;
			font-size: 1.1rem;
			font-weight: 400;
		}

		.mobile-nav[open] summary::after {
			content: '−';
		}

		.mobile-nav nav {
			position: absolute;
			top: 70px;
			left: 0;
			display: grid;
			width: 100%;
			padding: 12px 20px 22px;
			border-bottom: 1px solid #e6e7e9;
			background: #fff;
			box-shadow: 0 18px 30px rgb(17 19 24 / 6%);
		}

		.mobile-nav nav a {
			padding: 12px 0;
			border-bottom: 1px solid #eff0f1;
			font-size: 0.96rem;
			text-decoration: none;
		}

		.mobile-nav nav a[aria-current='page'] {
			color: #8a6300;
		}

		.mobile-nav nav .mobile-ucf {
			padding-bottom: 4px;
			border: 0;
			color: #8a6300;
			font-weight: 750;
			letter-spacing: 0.08em;
		}
	}
</style>

<style is:global>
	#inverse-design,
	#synthesis-science,
	#defects-interfaces,
	.year-group {
		scroll-margin-top: 96px;
	}

	@media (max-width: 800px) {
		#inverse-design,
		#synthesis-science,
		#defects-interfaces,
		.year-group {
			scroll-margin-top: 86px;
		}
	}
</style>
