---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-identity">
			<p class="footer-name">Gupta Research Group</p>
			<p><a class="footer-affiliation" href="https://www.ucf.edu/" target="_blank" rel="noopener noreferrer">University of Central Florida</a></p>
			<p><a class="footer-affiliation" href="https://nanoscience.ucf.edu/" target="_blank" rel="noopener noreferrer">NanoScience Technology Center and</a></p>
			<p><a class="footer-affiliation" href="https://mse.ucf.edu/" target="_blank" rel="noopener noreferrer">Department of Materials Science and Engineering</a></p>
			<p class="footer-email"><a class="footer-affiliation" href="mailto:sunny.gupta@ucf.edu">sunny.gupta@ucf.edu</a></p>
		</div>

		<nav class="footer-navigation" aria-label="Footer navigation">
			<p class="footer-heading">Navigate</p>
			<a href={base || '/'}>Home</a>
			<a href={`${base}/research`}>Research</a>
			<a href={`${base}/people`}>People</a>
			<a href={`${base}/publications`}>Publications</a>
			<a href={`${base}/join-us`}>Join Us</a>
		</nav>

		<div class="footer-links">
			<p class="footer-heading">Research profile</p>
			<a class="footer-scholar-link" href="https://scholar.google.com/citations?user=u0ByY3UAAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">
				<svg class="scholar-icon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 3 1.75 9 12 15l8.25-4.83V17h2V9L12 3Z" />
					<path d="M5.5 13.2V17c0 2.2 2.9 4 6.5 4s6.5-1.8 6.5-4v-3.8L12 17l-6.5-3.8Z" />
				</svg>
				<span>Google Scholar</span>
				<span class="external-arrow" aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
	<div class="footer-bottom">
		<p>© {currentYear} Gupta Research Group <span aria-hidden="true">·</span> University of Central Florida</p>
	</div>
</footer>

<style>
	.site-footer { border-top: 1px solid #dedfe2; background: #fafafa; color: #17191e; }
	.footer-inner, .footer-bottom { width: min(100% - 64px, 1440px); margin-inline: auto; }
	.footer-inner { display: grid; grid-template-columns: minmax(0, 2fr) minmax(140px, 1fr) minmax(180px, 1fr); gap: clamp(40px, 7vw, 104px); padding-block: clamp(40px, 4.5vw, 58px); }
	.footer-identity p { margin: 0; color: #62666e; font-size: 0.84rem; line-height: 1.75; }
	.footer-identity .footer-name { margin-bottom: 12px; color: #17191e; font-family: Georgia, 'Times New Roman', serif; font-size: 1.25rem; line-height: 1.3; }
	.footer-identity .footer-email { margin-top: 10px; }
	.footer-affiliation { color: #343840; text-decoration: none; transition: color 160ms ease, text-decoration-color 160ms ease; }
	.footer-email .footer-affiliation { text-decoration: underline; text-decoration-color: #c99700; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
	.footer-heading { margin: 0 0 15px; color: #896400; font-size: 0.68rem; font-weight: 750; letter-spacing: 0.13em; text-transform: uppercase; }
	.footer-navigation { display: flex; flex-direction: column; align-items: flex-start; }
	.footer-navigation a { padding-block: 5px; color: #444850; font-size: 0.84rem; text-decoration: none; }
	.footer-navigation a:hover, .footer-navigation a:focus-visible, .footer-affiliation:hover, .footer-affiliation:focus-visible { color: #896400; text-decoration-color: #896400; }
	.footer-scholar-link { display: inline-flex; gap: 8px; align-items: center; padding-block: 5px; color: #343840; font-size: 0.84rem; font-weight: 620; text-decoration: none; }
	.footer-scholar-link:hover, .footer-scholar-link:focus-visible { color: #896400; }
	.scholar-icon { display: block; width: 18px; height: 18px; fill: currentColor; }
	.external-arrow { color: #896400; font-size: 1rem; font-weight: 500; line-height: 1; }
	.footer-bottom { padding-block: 18px 22px; border-top: 1px solid #dedfe2; }
	.footer-bottom p { margin: 0; color: #777b82; font-size: 0.74rem; line-height: 1.5; }
	.footer-bottom span { margin-inline: 0.35em; color: #c99700; }

	@media (max-width: 600px) {
		.footer-inner, .footer-bottom { width: min(100% - 40px, 1440px); }
		.footer-inner { grid-template-columns: 1fr; gap: 34px; padding-block: 38px; }
		.footer-navigation a, .footer-scholar-link { min-height: 36px; padding-block: 8px; }
	}
</style>
