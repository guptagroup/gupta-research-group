---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import { publications } from '../data/publications';

const years = [...new Set(publications.map(({ year }) => year))];
const groups = years.map((year) => ({
	year,
	publications: publications.filter((publication) => publication.year === year),
}));
---

<Layout
	title="Publications | Gupta Research Group"
	description="Research publications from the Gupta Research Group at the University of Central Florida."
>
	<Header />
	<main>
		<header class="page-introduction">
			<div class="page-inner intro-layout">
				<div class="intro-copy">
					<p class="section-label">Publications</p>
					<h1>Publications</h1>
				</div>
				<div class="publication-record">
					<p>Complete Publication Record</p>
					<a href="https://scholar.google.com/citations?user=u0ByY3UAAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">Google Scholar <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</header>

		<div class="page-inner publication-content">
			<nav class="year-navigation" aria-label="Jump to publication year">
				{years.map((year, index) => (
					<><a href={`#year-${year}`}>{year}</a>{index < years.length - 1 && <span aria-hidden="true">·</span>}</>
				))}
			</nav>

			{groups.map((group) => (
				<section class="year-group" id={`year-${group.year}`} aria-labelledby={`heading-${group.year}`}>
					<header class="year-heading">
						<h2 id={`heading-${group.year}`}>{group.year}</h2>
					</header>
					<ol class="publication-list" start={publications.indexOf(group.publications[0]) + 1}>
						{group.publications.map((publication) => (
							<li class="publication">
								<h3>
									{publication.articleUrl ? (
										<a href={publication.articleUrl} target="_blank" rel="noopener noreferrer">{publication.title}</a>
									) : publication.title}
								</h3>
								<p class="authors">
									{publication.authors.split(/(S Gupta)/g).map((part) => part === 'S Gupta' ? <strong>{part}</strong> : part)}
								</p>
								<div class="publication-footer">
									<div class="metadata">
										<p class="journal">{publication.journal}</p>
										{publication.notes && <p class="notes">{publication.notes}</p>}
										{publication.articleUrl && <a class="article-link" href={publication.articleUrl} target="_blank" rel="noopener noreferrer">Article <span aria-hidden="true">↗</span></a>}
									</div>
					{publication.doi && <div class="altmetric-embed" data-badge-type="donut" data-hide-no-mentions="true" data-link-target="_blank" data-doi={publication.doi}></div>}
								</div>
							</li>
						))}
					</ol>
				</section>
			))}
		</div>
	</main>
	<Footer />
	<script is:inline src="https://embed.altmetric.com/assets/embed.js"></script>
	<script is:inline>
		(() => {
			const initializeAltmetric = () => {
				if (document.readyState !== 'loading' && typeof window._altmetric_embed_init === 'function') {
					window._altmetric_embed_init();
				}
			};

			if (typeof window._altmetric_embed_init === 'function') {
				initializeAltmetric();
			} else {
				document.getElementById('altmetric-embed-js')?.addEventListener('load', initializeAltmetric, { once: true });
			}
		})();
	</script>
</Layout>

<style>
	main { background: #fff; }
	.page-inner { width: min(100% - 64px, 1280px); margin-inline: auto; }
	.page-introduction { border-bottom: 1px solid #e3e3e0; background: #fafaf8; }
	.intro-layout { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 52px; align-items: center; padding-block: clamp(34px, 3.5vw, 48px); }
	.section-label, .publication-record p { margin: 0; color: #896400; font-size: 0.7rem; font-weight: 750; letter-spacing: 0.15em; text-transform: uppercase; }
	h1, h2, h3 { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; }
	h1 { margin: 16px 0 0; font-size: clamp(2.75rem, 4.5vw, 4.5rem); line-height: 1.06; letter-spacing: -0.04em; }
	.publication-record { min-width: 190px; padding-top: 18px; }
	.publication-record p { margin-bottom: 10px; }
	.publication-record a, .article-link { color: #343840; font-size: 0.88rem; font-weight: 620; text-decoration: none; }
	.publication-record a, .article-link { text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: 0.22em; transition: color 160ms ease, text-decoration-color 160ms ease; }
	.publication-record a:hover, .publication-record a:focus-visible, .article-link:hover, .article-link:focus-visible { color: #896400; text-decoration: underline; text-decoration-color: #c99700; }
	.publication-record span, .article-link span { color: #896400; }
	.publication-content { padding-block: 26px clamp(64px, 7vw, 96px); }
	.year-navigation { display: flex; flex-wrap: wrap; gap: 8px 12px; padding: 4px 0 17px; border-bottom: 1px solid #e5e5e2; background: transparent; color: #777b82; font-size: 0.77rem; letter-spacing: 0.015em; }
	.year-navigation a { padding-block: 2px; color: #62666e; font-weight: 650; text-decoration: none; text-underline-offset: 0.25em; transition: color 160ms ease, text-decoration-color 160ms ease; }
	.year-navigation a:hover, .year-navigation a:focus-visible { color: #896400; text-decoration: underline; text-decoration-color: #c99700; }
	.year-navigation span { color: #c99700; }
	.year-group { padding-top: clamp(30px, 3.5vw, 44px); scroll-margin-top: 20px; }
	.year-heading { display: flex; align-items: center; gap: 18px; }
	.year-heading::after { content: ''; height: 1px; flex: 1; background: #d9d9d5; }
	.year-heading h2 { margin: 0; color: #896400; font-family: inherit; font-size: 0.8rem; font-weight: 760; letter-spacing: 0.13em; }
	.publication-list { margin: 0; padding: 0; list-style: none; }
	.publication { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 32px; margin: 0; padding-block: 23px 24px; }
	.publication + .publication { border-top: 1px solid #e3e3df; }
	.publication h3 { grid-column: 1; max-width: 980px; margin: 0; color: #17191e; font-size: clamp(1.2rem, 1.75vw, 1.55rem); line-height: 1.3; letter-spacing: -0.015em; text-wrap: pretty; }
	.publication h3 a { color: inherit; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: 0.18em; transition: color 160ms ease, text-decoration-color 160ms ease; }
	.publication h3 a:hover, .publication h3 a:focus-visible { color: #6f5200; text-decoration-color: #c99700; }
	.authors { grid-column: 1; max-width: 1040px; margin: 10px 0 0; color: #4f535b; font-size: 0.9rem; line-height: 1.55; overflow-wrap: anywhere; }
	.authors strong { color: #2f3339; font-weight: 650; }
	.publication-footer { display: contents; }
	.metadata { display: flex; grid-column: 1; flex-wrap: wrap; gap: 5px 14px; align-items: baseline; min-width: 0; max-width: 1040px; margin-top: 8px; }
	.journal, .notes { margin: 0; font-size: 0.82rem; line-height: 1.5; }
	.journal { color: #62666e; }
	.notes { color: #7a6a3f; font-style: italic; }
	.article-link { font-size: 0.78rem; white-space: nowrap; }
	.altmetric-embed { grid-column: 2; grid-row: 1 / 4; align-self: center; justify-self: end; line-height: 0; }

	@media (max-width: 700px) {
		.page-inner { width: min(100% - 40px, 1280px); }
		.intro-layout { grid-template-columns: 1fr; gap: 22px; padding-block: 32px 36px; }
		h1 { font-size: clamp(2.45rem, 12vw, 3.35rem); }
		.publication-record { padding: 0; }
		.publication-content { padding-top: 20px; }
		.year-navigation { gap: 7px 10px; padding: 3px 0 15px; }
		.year-group { padding-top: 30px; }
		.publication { grid-template-columns: minmax(0, 1fr); padding-block: 21px 22px; }
		.publication h3 { font-size: 1.2rem; }
		.publication h3, .authors, .metadata { grid-column: 1; }
		.metadata { display: grid; gap: 5px; }
		.altmetric-embed { grid-column: 1; grid-row: auto; justify-self: start; margin-top: 12px; }
	}
</style>
