<script>
	const initializePublicationCarousel = () => {
		const carousel = document.querySelector<HTMLElement>('.publication-carousel');
		if (!carousel || carousel.dataset.initialized === 'true') return;
		carousel.dataset.initialized = 'true';

		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.publication'));
		const previous = carousel.querySelector<HTMLButtonElement>('.carousel-previous');
		const next = carousel.querySelector<HTMLButtonElement>('.carousel-next');
		const position = carousel.querySelector<HTMLElement>('.carousel-position');
		const currentNumber = carousel.querySelector<HTMLElement>('.carousel-current');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let current = 0;
		let timer: number | undefined;
		let keyboardFocusInside = false;

		const showSlide = (index: number) => {
			current = (index + slides.length) % slides.length;
			slides.forEach((slide, slideIndex) => {
				const active = slideIndex === current;
				slide.classList.toggle('is-active', active);
				slide.setAttribute('aria-hidden', String(!active));
				slide.toggleAttribute('inert', !active);
			});
			if (currentNumber) currentNumber.textContent = String(current + 1).padStart(2, '0');
			position?.setAttribute('aria-label', `Publication ${current + 1} of ${slides.length}`);
		};

		const stopAutoAdvance = () => {
			if (timer !== undefined) window.clearInterval(timer);
			timer = undefined;
		};

		const startAutoAdvance = () => {
			stopAutoAdvance();
			if (!reducedMotion.matches && !keyboardFocusInside && !document.hidden) {
				timer = window.setInterval(() => showSlide(current + 1), 5000);
			}
		};

		const selectManually = (index: number) => {
			stopAutoAdvance();
			showSlide(index);
			startAutoAdvance();
		};

		previous?.addEventListener('click', () => selectManually(current - 1));
		next?.addEventListener('click', () => selectManually(current + 1));
		carousel.addEventListener('focusin', (event) => {
			const target = event.target as HTMLElement;
			if (target.matches(':focus-visible')) {
				keyboardFocusInside = true;
				stopAutoAdvance();
			}
		});
		carousel.addEventListener('focusout', (event) => {
			if (!carousel.contains(event.relatedTarget as Node | null)) {
				keyboardFocusInside = false;
				startAutoAdvance();
			}
		});
		reducedMotion.addEventListener('change', startAutoAdvance);
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stopAutoAdvance();
			else startAutoAdvance();
		});
		showSlide(0);
		startAutoAdvance();
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializePublicationCarousel, { once: true });
	} else {
		initializePublicationCarousel();
	}
</script>

