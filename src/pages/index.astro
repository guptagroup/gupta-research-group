---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Header />
	<main>
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">Gupta Research Group <span aria-hidden="true">·</span> UCF</p>
				<h1 id="hero-title">Designing materials for next-generation quantum and electronic technologies</h1>
				<p class="introduction">
					We combine quantum-mechanical simulations and machine learning to design low-dimensional materials for
					future technologies.
				</p>
				<a class="cta" href="#">Explore Our Research <span aria-hidden="true">→</span></a>
			</div>

			<figure class="hero-visual">
				<img
					src="/images/hero.png"
					alt="Scientific visualization of quantum states, a low-dimensional atomic lattice, and electronic waves"
					width="1671"
					height="941"
					fetchpriority="high"
				/>
			</figure>
		</section>

		<section class="about" aria-labelledby="about-heading">
			<div class="section-inner about-inner">
				<h2 id="about-heading" class="section-label">About the Group</h2>
				<div class="about-statement">
					<p>
						Materials are the foundation of every electronic system. Our interdisciplinary group integrates inverse
						materials design, synthesis science, and defect and interface engineering to address fundamental materials
						challenges in next-generation quantum and electronic technologies.
					</p>
					<p>
						We develop and apply computational approaches to discover emergent electronic phenomena in low-dimensional
						materials, design predictive synthesis pathways, identify high-performance defects for spin-photonic qubits,
						and understand interfacial phenomena critical to advanced microelectronics.
					</p>
				</div>
			</div>
		</section>

		<section class="research" aria-labelledby="research-heading">
			<div class="section-inner">
				<header class="research-header">
					<p class="section-label">Our Research</p>
					<h2 id="research-heading">Research directions</h2>
				</header>

				<div class="research-grid">
					<article class="research-area">
						<figure class="research-image">
							<img
								src="/images/inverse-design.png"
								alt="Scientific visualization representing inverse design of low-dimensional quantum materials"
								width="1250"
								height="1245"
								loading="lazy"
							/>
						</figure>
						<h3>Inverse Design of 2D Quantum Materials</h3>
						<p>
							Developing design principles and descriptors for discovering materials with targeted electronic
							functionalities.
						</p>
						<a href="#">Explore research <span aria-hidden="true">→</span></a>
					</article>

					<article class="research-area">
						<figure class="research-image">
							<img
								src="/images/synthesis.png"
								alt="Scientific visualization of molecular deposition and material formation on a surface"
								width="1448"
								height="1086"
								loading="lazy"
							/>
						</figure>
						<h3>Synthesis Science</h3>
						<p>
							Understanding the mechanisms and pathways that govern materials formation to develop predictive
							approaches for materials synthesis.
						</p>
						<a href="#">Explore research <span aria-hidden="true">→</span></a>
					</article>

					<article class="research-area">
						<figure class="research-image">
							<img
								src="/images/defects-interface.png"
								alt="Atomic-scale scientific visualization of defects and interfaces in a material"
								width="1254"
								height="1254"
								loading="lazy"
							/>
						</figure>
						<h3>Defect &amp; Interface Design</h3>
						<p>
							Engineering defects and interfaces to control and create functional properties and devices for quantum and
							electronic applications.
						</p>
						<a href="#">Explore research <span aria-hidden="true">→</span></a>
					</article>
				</div>
			</div>
		</section>

		<section class="pi" aria-labelledby="pi-heading">
			<div class="section-inner pi-inner">
				<figure class="pi-portrait">
					<img
						src="/images/sunny-gupta.png"
						alt="Sunny Gupta, Assistant Professor at the University of Central Florida"
						width="2028"
						height="2028"
						loading="lazy"
					/>
				</figure>

				<div class="pi-profile">
					<p class="section-label">Meet the PI</p>
					<h2 id="pi-heading">Sunny Gupta</h2>
					<p class="pi-title">Assistant Professor</p>
					<div class="pi-affiliations">
						<p>NanoScience Technology Center</p>
						<p>Department of Materials Science and Engineering</p>
						<p>University of Central Florida</p>
					</div>
					<a class="pi-link" href="#">Learn more <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		overflow: hidden;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
		align-items: center;
		gap: clamp(42px, 5vw, 84px);
		width: min(100% - 64px, 1440px);
		min-height: calc(100vh - 80px);
		max-height: 880px;
		margin-inline: auto;
		padding-block: clamp(48px, 6vh, 78px);
	}

	.hero-copy {
		max-width: 730px;
	}

	.eyebrow {
		margin: 0 0 24px;
		color: #896400;
		font-size: 0.74rem;
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.eyebrow span {
		margin-inline: 0.35em;
		color: #ffc904;
	}

	h1 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.8rem, 4.25vw, 4.75rem);
		font-weight: 400;
		line-height: 1.04;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.introduction {
		max-width: 670px;
		margin: 30px 0 0;
		color: #4b4f57;
		font-size: clamp(1rem, 1.15vw, 1.12rem);
		line-height: 1.72;
	}

	.cta {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		margin-top: 34px;
		padding-bottom: 9px;
		font-size: 0.9rem;
		font-weight: 620;
		text-decoration: none;
		position: relative;
	}

	.cta::after {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 38px;
		height: 1px;
		background: #c99700;
		content: '';
		transition: width 160ms ease;
	}

	.cta span {
		font-size: 1.15em;
		transition: transform 160ms ease;
	}

	.cta:hover span,
	.cta:focus-visible span {
		transform: translateX(4px);
	}

	.cta:hover::after,
	.cta:focus-visible::after {
		width: 52px;
	}

	.hero-visual {
		margin: 0;
	}

	.hero-visual img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1671 / 941;
		object-fit: contain;
	}

	.section-inner {
		width: min(100% - 64px, 1440px);
		margin-inline: auto;
	}

	.section-label {
		margin: 0;
		color: #896400;
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.about {
		padding-block: clamp(76px, 8vw, 128px);
		border-top: 1px solid #ececef;
	}

	.about-inner {
		display: grid;
		grid-template-columns: minmax(150px, 1fr) minmax(0, 3fr);
		gap: clamp(40px, 7vw, 112px);
		align-items: start;
	}

	.about-statement {
		max-width: 820px;
		margin: -0.16em 0 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.625rem, 2vw, 1.875rem);
		font-weight: 400;
		line-height: 1.38;
		letter-spacing: -0.02em;
		text-wrap: pretty;
	}

	.about-statement p {
		margin: 0;
	}

	.about-statement p + p {
		margin-top: 1em;
	}

	.research {
		padding-block: clamp(88px, 9vw, 144px) clamp(112px, 11vw, 176px);
		border-top: 1px solid #dedfe2;
	}

	.research-header {
		margin-bottom: clamp(48px, 5vw, 72px);
	}

	.research-header h2 {
		margin: 16px 0 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.3rem, 3.4vw, 3.5rem);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.research-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(28px, 3.4vw, 54px);
	}

	.research-area {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding-top: 18px;
		border-top: 1px solid #c9cacf;
	}

	.research-image {
		width: min(100%, 440px);
		aspect-ratio: 1 / 1;
		margin: 0 auto 30px;
		border-radius: 50%;
		overflow: hidden;
	}

	.research-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 220ms ease;
	}

	.research-area:hover .research-image img {
		transform: scale(1.015);
	}

	.research-area h3 {
		min-height: 2.4em;
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.45rem, 1.8vw, 1.85rem);
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.research-area > p {
		margin: 18px 0 24px;
		color: #555a63;
		font-size: 0.97rem;
		line-height: 1.7;
	}

	.research-area > a {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		align-self: flex-start;
		margin-top: auto;
		padding-bottom: 5px;
		border-bottom: 1px solid #c99700;
		font-size: 0.84rem;
		font-weight: 650;
		text-decoration: none;
	}

	.research-area > a span {
		transition: transform 160ms ease;
	}

	.research-area > a:hover span,
	.research-area > a:focus-visible span {
		transform: translateX(3px);
	}

	.pi {
		padding-block: clamp(88px, 10vw, 152px);
		border-top: 1px solid #dedfe2;
	}

	.pi-inner {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		gap: clamp(56px, 8vw, 128px);
		align-items: center;
	}

	.pi-portrait {
		margin: 0;
	}

	.pi-portrait img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		object-position: 56% center;
	}

	.pi-profile {
		max-width: 650px;
	}

	.pi-profile h2 {
		margin: 18px 0 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.75rem, 4.6vw, 4.75rem);
		font-weight: 400;
		line-height: 1.03;
		letter-spacing: -0.045em;
	}

	.pi-title {
		margin: 18px 0 0;
		color: #343840;
		font-size: clamp(1.05rem, 1.3vw, 1.2rem);
		font-weight: 600;
	}

	.pi-affiliations {
		margin-top: 30px;
		padding-top: 25px;
		border-top: 1px solid #dedfe2;
		color: #555a63;
		font-size: 0.98rem;
		line-height: 1.65;
	}

	.pi-affiliations p {
		margin: 0;
	}

	.pi-link {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		margin-top: 34px;
		padding-bottom: 5px;
		border-bottom: 1px solid #c99700;
		font-size: 0.87rem;
		font-weight: 650;
		text-decoration: none;
	}

	.pi-link span {
		transition: transform 160ms ease;
	}

	.pi-link:hover span,
	.pi-link:focus-visible span {
		transform: translateX(3px);
	}

	@media (max-width: 980px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 48px;
			min-height: auto;
			max-height: none;
			padding-block: 54px;
		}

		.hero-copy {
			max-width: 790px;
		}

		.hero-visual {
			width: 100%;
		}

		.about-inner {
			grid-template-columns: 1fr;
			gap: 28px;
		}

		.about-statement {
			max-width: 900px;
			margin-top: 0;
		}

		.research-grid {
			gap: 26px;
		}

		.research-image {
			margin-bottom: 24px;
		}

		.pi-inner {
			gap: clamp(40px, 6vw, 64px);
		}
	}

	@media (max-width: 600px) {
		.hero {
			width: min(100% - 40px, 1440px);
			gap: 40px;
			padding-block: 42px 48px;
		}

		.eyebrow {
			margin-bottom: 18px;
		}

		h1 {
			font-size: clamp(2.35rem, 11vw, 3.3rem);
			line-height: 1.06;
		}

		.introduction {
			margin-top: 24px;
			font-size: 1rem;
			line-height: 1.65;
		}

		.cta {
			margin-top: 28px;
		}

		.section-inner {
			width: min(100% - 40px, 1440px);
		}

		.about {
			padding-block: 62px 68px;
		}

		.about-statement {
			font-size: clamp(1.5rem, 6vw, 1.75rem);
			line-height: 1.4;
		}

		.research {
			padding-block: 78px 108px;
		}

		.research-header {
			margin-bottom: 44px;
		}

		.research-grid {
			grid-template-columns: 1fr;
			gap: 62px;
		}

		.research-image {
			margin-bottom: 26px;
		}

		.research-area h3 {
			font-size: 1.7rem;
		}

		.pi {
			padding-block: 72px 88px;
		}

		.pi-inner {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.pi-profile h2 {
			font-size: clamp(2.6rem, 13vw, 3.5rem);
		}

		.pi-affiliations {
			margin-top: 26px;
			padding-top: 22px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.research-image img,
		.research-area > a span,
		.pi-link span {
			transition: none;
		}
	}
</style>
