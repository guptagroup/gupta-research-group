---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Header />
	<main>
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">Gupta Research Group <span aria-hidden="true">·</span> UCF</p>
				<h1 id="hero-title">Designing materials for next-generation quantum and electronic technologies</h1>
				<p class="introduction">
					We are an interdisciplinary group that employs and develops computational approaches integrating
					quantum-mechanical simulations with machine learning to solve challenges in designing low-dimensional
					materials for next-generation quantum and electronic applications.
				</p>
				<a class="cta" href="#">Explore Our Research <span aria-hidden="true">→</span></a>
			</div>

			<figure class="hero-visual">
				<img
					src="/images/hero.png"
					alt="Scientific visualization of quantum states, a low-dimensional atomic lattice, and electronic waves"
					width="1671"
					height="941"
					fetchpriority="high"
				/>
			</figure>
		</section>
	</main>
</Layout>

<style>
	main {
		overflow: hidden;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
		align-items: center;
		gap: clamp(42px, 5vw, 84px);
		width: min(100% - 64px, 1440px);
		min-height: calc(100vh - 80px);
		max-height: 880px;
		margin-inline: auto;
		padding-block: clamp(48px, 6vh, 78px);
	}

	.hero-copy {
		max-width: 730px;
	}

	.eyebrow {
		margin: 0 0 24px;
		color: #896400;
		font-size: 0.74rem;
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.eyebrow span {
		margin-inline: 0.35em;
		color: #ffc904;
	}

	h1 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.8rem, 4.25vw, 4.75rem);
		font-weight: 400;
		line-height: 1.04;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.introduction {
		max-width: 670px;
		margin: 30px 0 0;
		color: #4b4f57;
		font-size: clamp(1rem, 1.15vw, 1.12rem);
		line-height: 1.72;
	}

	.cta {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		margin-top: 34px;
		padding-bottom: 9px;
		font-size: 0.9rem;
		font-weight: 620;
		text-decoration: none;
		position: relative;
	}

	.cta::after {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 38px;
		height: 1px;
		background: #c99700;
		content: '';
		transition: width 160ms ease;
	}

	.cta span {
		font-size: 1.15em;
		transition: transform 160ms ease;
	}

	.cta:hover span,
	.cta:focus-visible span {
		transform: translateX(4px);
	}

	.cta:hover::after,
	.cta:focus-visible::after {
		width: 52px;
	}

	.hero-visual {
		margin: 0;
	}

	.hero-visual img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1671 / 941;
		object-fit: contain;
	}

	@media (max-width: 980px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 48px;
			min-height: auto;
			max-height: none;
			padding-block: 54px;
		}

		.hero-copy {
			max-width: 790px;
		}

		.hero-visual {
			width: 100%;
		}
	}

	@media (max-width: 600px) {
		.hero {
			width: min(100% - 40px, 1440px);
			gap: 40px;
			padding-block: 42px 48px;
		}

		.eyebrow {
			margin-bottom: 18px;
		}

		h1 {
			font-size: clamp(2.35rem, 11vw, 3.3rem);
			line-height: 1.06;
		}

		.introduction {
			margin-top: 24px;
			font-size: 1rem;
			line-height: 1.65;
		}

		.cta {
			margin-top: 28px;
		}
	}
</style>
