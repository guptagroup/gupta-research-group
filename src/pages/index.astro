---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import { getPublicationByDoi } from '../data/publications';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const selectedPublications = [
	{ doi: '10.1016/j.matt.2025.102378', image: 'matter_2025.jpg' },
	{ doi: '10.1021/acs.chemrev.4c00628', image: 'chemical_reviews_2025.png' },
	{ doi: '10.1038/s41467-023-42538-2', image: 'nature_comm_2023.png' },
	{ doi: '10.1038/s41467-022-30818-2', image: 'nature_comm_2022.png' },
	{ doi: '10.1021/jacs.0c12809', image: 'JACS_2021.png' },
	{ doi: '10.1038/s41467-020-16737-0', image: 'nature_comm_2020.png' },
	{ doi: '10.1021/acs.nanolett.8b04159', image: 'nano_letter_2019.png' },
	{ doi: '10.1021/acsnano.8b03754', image: 'ACS_Nano_2018.png' },
].map(({ doi, image }) => ({ publication: getPublicationByDoi(doi), image }));
---

<Layout>
	<Header />
	<main>
		<section
			class="hero"
			aria-labelledby="hero-title"
			style={`--hero-image: url("${base}/images/hero1.png")`}
		>
			<div class="hero-copy">
				<p class="eyebrow page-eyebrow">Gupta Research Group <span aria-hidden="true">·</span> UCF</p>
				<h1 id="hero-title">Designing materials for next-generation quantum and electronic technologies</h1>
				<p class="introduction">
					We combine quantum-mechanical simulations and machine learning to design two-dimensional materials for
					future technologies.
				</p>
				<a class="cta" href={`${base}/research`}>Explore Our Research <span aria-hidden="true">→</span></a>
			</div>
		</section>

		<section class="about" aria-labelledby="about-heading">
			<div class="section-inner">
				<div class="about-inner">
					<div class="about-introduction">
						<h2 id="about-heading" class="section-label">About the Group</h2>
						<p class="about-statement">Materials are the foundation of every electronic system.</p>
					</div>
					<div class="about-copy">
					<p>
						We are an interdisciplinary group addressing fundamental challenges in two-dimensional materials for
						next-generation quantum and electronic technologies. Our research spans the full materials-to-device pathway:
						discovering materials with targeted functionalities, predicting how they can be synthesized, and understanding
						how they can be integrated into functional devices—reducing reliance on trial-and-error experimentation.
					</p>
					<p>
						Working at the intersection of computational physics, materials science, quantum chemistry, and electronics, we
						develop and apply atomistic simulation approaches to uncover emergent electronic phenomena in two-dimensional
						materials, design predictive synthesis pathways, identify high-performance defects for spin-photonic qubits, and
						understand interfacial phenomena critical to advanced microelectronics.
					</p>
					</div>
				</div>
				</div>
		</section>

		<section class="research" aria-labelledby="research-heading">
			<div class="section-inner">
				<header class="research-header">
					<p class="section-label">Our Research</p>
					<h2 id="research-heading">Research directions</h2>
				</header>

				<div class="research-grid">
					<article class="research-area">
						<figure class="research-image">
							<img
								src={`${base}/images/inverse-design.png`}
								alt="Scientific visualization representing inverse design of low-dimensional quantum materials"
								width="1250"
								height="1245"
								loading="lazy"
							/>
						</figure>
						<h3>Inverse Design of 2D Quantum Materials</h3>
						<p>
							Developing design principles and descriptors for discovering materials with targeted electronic
							functionalities.
						</p>
						<a href={`${base}/research#inverse-design`}>Explore research <span aria-hidden="true">→</span></a>
					</article>

					<article class="research-area">
						<figure class="research-image">
							<img
								src={`${base}/images/synthesis.png`}
								alt="Scientific visualization of molecular deposition and material formation on a surface"
								width="1448"
								height="1086"
								loading="lazy"
							/>
						</figure>
						<h3>Synthesis Science</h3>
						<p>
							Understanding the mechanisms and pathways that govern materials formation to develop predictive
							approaches for materials synthesis.
						</p>
						<a href={`${base}/research#synthesis-science`}>Explore research <span aria-hidden="true">→</span></a>
					</article>

					<article class="research-area">
						<figure class="research-image">
							<img
								src={`${base}/images/defects-interface.png`}
								alt="Atomic-scale scientific visualization of defects and interfaces in a material"
								width="1254"
								height="1254"
								loading="lazy"
							/>
						</figure>
						<h3>Defect &amp; Interface Design</h3>
						<p>
							Engineering defects and interfaces to control and create functional properties and devices for quantum and
							electronic applications.
						</p>
						<a href={`${base}/research#defects-interfaces`}>Explore research <span aria-hidden="true">→</span></a>
					</article>
				</div>
			</div>
		</section>

		<section class="pi" aria-labelledby="pi-heading">
			<div class="section-inner pi-inner">
				<figure class="pi-portrait">
					<img
						src={`${base}/images/sunny-gupta.png`}
						alt="Sunny Gupta, Assistant Professor at the University of Central Florida"
						width="2028"
						height="2028"
						loading="lazy"
					/>
				</figure>

				<div class="pi-profile">
					<p class="section-label">Meet the PI</p>
					<h2 id="pi-heading">Sunny Gupta</h2>
					<p class="pi-title">Assistant Professor</p>
					<div class="pi-affiliations">
						<p>NanoScience Technology Center</p>
						<p>Department of Materials Science and Engineering</p>
						<p>University of Central Florida</p>
					</div>
					<p class="pi-email"><a href="mailto:sunny.gupta@ucf.edu">sunny.gupta@ucf.edu</a></p>
					<a class="pi-link" href={`${base}/people`}>Learn more <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</section>

		<section class="publications" aria-labelledby="publications-heading">
			<div class="section-inner publications-inner">
				<header class="publications-header">
					<div>
						<p class="section-label">Publications</p>
						<h2 id="publications-heading">Selected Publications</h2>
					</div>
					<div class="publication-record">
						<p class="publication-record-label">Complete Publication Record</p>
						<a
							class="scholar-link"
							href="https://scholar.google.com/citations?user=u0ByY3UAAAAJ&amp;hl=en"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="View complete publication record on Google Scholar (opens in a new tab)"
							title="Google Scholar"
						>
							<svg class="scholar-icon" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 3 1.75 9 12 15l8.25-4.83V17h2V9L12 3Z" />
								<path d="M5.5 13.2V17c0 2.2 2.9 4 6.5 4s6.5-1.8 6.5-4v-3.8L12 17l-6.5-3.8Z" />
							</svg>
							<span>Google Scholar</span>
							<span class="external-arrow" aria-hidden="true">↗</span>
						</a>
					</div>
				</header>

				<div class="publication-carousel" aria-roledescription="carousel" aria-label="Selected publications">
				<ol class="publication-list" aria-live="off">
					{selectedPublications.map(({ publication, image }, index) => (
						<li class:list={['publication', { 'is-active': index === 0 }]} aria-hidden={index === 0 ? 'false' : 'true'} inert={index === 0 ? undefined : true}>
							<div class="publication-details">
								<p class="publication-meta">{publication.year} <span aria-hidden="true">/</span> {publication.journal.split(',')[0]}</p>
								<h3>
									{publication.articleUrl ? (
										<a href={publication.articleUrl} target="_blank" rel="noopener noreferrer">{publication.title}</a>
									) : publication.title}
								</h3>
								<p class="publication-authors">
									{publication.authors.split(/(S Gupta)/g).map((part) => part === 'S Gupta' ? <strong>{part}</strong> : part)}
								</p>
								<div class="publication-citation">
									<div>
										<p class="publication-journal">{publication.journal}</p>
										{publication.notes && <p class="publication-notes">{publication.notes}</p>}
										{publication.articleUrl && (
											<a class="publication-link" href={publication.articleUrl} target="_blank" rel="noopener noreferrer">
												View article <span aria-hidden="true">↗</span>
											</a>
										)}
									</div>
									{publication.doi && <div class="altmetric-embed" data-badge-type="donut" data-hide-no-mentions="true" data-doi={publication.doi}></div>}
								</div>
							</div>
							<figure class="publication-image-frame">
								<img
									src={`${base}/images/publications/${image}`}
									alt={`Representative figure for “${publication.title}”`}
									loading="lazy"
								/>
							</figure>
						</li>
					))}
				</ol>

					<div class="carousel-controls" aria-label="Publication carousel controls">
						<button class="carousel-arrow carousel-previous" type="button" aria-label="Show previous publication">←</button>
						<p class="carousel-position" aria-label="Publication 1 of 8"><span class="carousel-current">01</span> / 08</p>
						<button class="carousel-arrow carousel-next" type="button" aria-label="Show next publication">→</button>
					</div>
				</div>
			</div>
			<script is:inline type="text/javascript" src="https://embed.altmetric.com/assets/embed.js"></script>
		</section>

		<section class="join" aria-labelledby="join-heading">
			<div class="section-inner join-inner">
				<p class="join-label">Join Us</p>
				<h2 id="join-heading">Join the Gupta Research Group</h2>
				<p class="join-introduction">
					We welcome students and researchers interested in computational materials science, two-dimensional
					quantum materials, synthesis science, and defect and interface engineering.
				</p>
				<a class="join-link" href={`${base}/join-us`}>Explore Opportunities <span aria-hidden="true">→</span></a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	const initializePublicationCarousel = () => {
		const carousel = document.querySelector<HTMLElement>('.publication-carousel');
		if (!carousel || carousel.dataset.initialized === 'true') return;
		carousel.dataset.initialized = 'true';

		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.publication'));
		const previous = carousel.querySelector<HTMLButtonElement>('.carousel-previous');
		const next = carousel.querySelector<HTMLButtonElement>('.carousel-next');
		const position = carousel.querySelector<HTMLElement>('.carousel-position');
		const currentNumber = carousel.querySelector<HTMLElement>('.carousel-current');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let current = 0;
		let timer: number | undefined;
		let keyboardFocusInside = false;

		const showSlide = (index: number) => {
			current = (index + slides.length) % slides.length;
			slides.forEach((slide, slideIndex) => {
				const active = slideIndex === current;
				slide.classList.toggle('is-active', active);
				slide.setAttribute('aria-hidden', String(!active));
				slide.toggleAttribute('inert', !active);
			});
			if (currentNumber) currentNumber.textContent = String(current + 1).padStart(2, '0');
			position?.setAttribute('aria-label', `Publication ${current + 1} of ${slides.length}`);
		};

		const stopAutoAdvance = () => {
			if (timer !== undefined) window.clearInterval(timer);
			timer = undefined;
		};

		const startAutoAdvance = () => {
			stopAutoAdvance();
			if (!reducedMotion.matches && !keyboardFocusInside && !document.hidden) {
				timer = window.setInterval(() => showSlide(current + 1), 5000);
			}
		};

		const selectManually = (index: number) => {
			stopAutoAdvance();
			showSlide(index);
			startAutoAdvance();
		};

		previous?.addEventListener('click', () => selectManually(current - 1));
		next?.addEventListener('click', () => selectManually(current + 1));
		carousel.addEventListener('focusin', (event) => {
			const target = event.target as HTMLElement;
			if (target.matches(':focus-visible')) {
				keyboardFocusInside = true;
				stopAutoAdvance();
			}
		});
		carousel.addEventListener('focusout', (event) => {
			if (!carousel.contains(event.relatedTarget as Node | null)) {
				keyboardFocusInside = false;
				startAutoAdvance();
			}
		});
		reducedMotion.addEventListener('change', startAutoAdvance);
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stopAutoAdvance();
			else startAutoAdvance();
		});
		showSlide(0);
		startAutoAdvance();
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializePublicationCarousel, { once: true });
	} else {
		initializePublicationCarousel();
	}
</script>

<style>
	main {
		--text-body: clamp(1rem, 1.05vw, 1.15rem);
		--text-body-lead: clamp(1.15rem, 1.2vw, 1.35rem);
		--body-line-height: 1.6;
		overflow: hidden;
	}

	.hero {
		display: flex;
		align-items: center;
		min-height: clamp(560px, calc(100svh - 80px), 620px);
		padding: clamp(64px, 7vw, 96px) max(32px, calc((100% - 1440px) / 2));
		background-color: #121820;
		background-image:
			linear-gradient(90deg, rgb(10 15 22 / 96%) 0%, rgb(10 15 22 / 88%) 36%, rgb(10 15 22 / 48%) 60%, rgb(10 15 22 / 10%) 82%),
			var(--hero-image);
		background-position: center, center right;
		background-size: cover;
		box-shadow: inset 0 -1px rgb(255 255 255 / 10%), 0 12px 32px rgb(17 19 24 / 10%);
	}

	.hero-copy {
		width: min(52%, 730px);
		color: #f7f5ef;
	}

	.hero .page-eyebrow {
		color: #e4b526;
	}

	.eyebrow span {
		margin-inline: 0.35em;
		color: #ffc904;
	}

	.eyebrow + h1 {
		margin-top: var(--page-eyebrow-heading-gap);
	}

	h1 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.8rem, 4.25vw, 4.75rem);
		font-weight: 400;
		line-height: 1.04;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.introduction {
		max-width: 670px;
		margin: 30px 0 0;
		color: #dedfe1;
		font-size: clamp(1rem, 1.15vw, 1.12rem);
		line-height: 1.72;
	}

	.cta {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		margin-top: 34px;
		padding-bottom: 9px;
		font-size: 0.9rem;
		font-weight: 620;
		color: #f7f5ef;
		text-decoration: none;
		position: relative;
	}

	.cta::after {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 38px;
		height: 1px;
		background: #c99700;
		content: '';
		transition: width 160ms ease;
	}

	.cta span {
		font-size: 1.15em;
		transition: transform 160ms ease;
	}

	.cta:hover span,
	.cta:focus-visible span {
		transform: translateX(4px);
	}

	.cta:hover::after,
	.cta:focus-visible::after {
		width: 52px;
	}

	.section-inner {
		width: min(100% - 64px, 1440px);
		margin-inline: auto;
	}

	.section-label {
		margin: 0;
		color: #896400;
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.about {
		padding-block: clamp(56px, 6vw, 88px) clamp(52px, 5.5vw, 80px);
		border-top: 1px solid #ececef;
		background: #fbfaf7;
	}

	.about-inner {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
		gap: clamp(52px, 7vw, 112px);
		align-items: start;
	}

	.about-statement {
		max-width: 510px;
		margin: 24px 0 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.25rem, 3vw, 2.625rem);
		font-weight: 400;
		line-height: 1.14;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.about-copy {
		max-width: 760px;
		font-family: inherit;
		font-size: var(--text-body-lead);
		font-weight: 400;
		line-height: var(--body-line-height);
		letter-spacing: normal;
		text-wrap: pretty;
	}

	.about-copy p {
		margin: 0;
	}

	.about-copy p + p {
		margin-top: 1.1em;
	}

	.research {
		padding-block: clamp(64px, 6.5vw, 96px) clamp(76px, 7.5vw, 108px);
		border-top: 1px solid #dedfe2;
	}

	.research-header {
		margin-bottom: clamp(48px, 5vw, 72px);
	}

	.research-header h2 {
		margin: 16px 0 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.3rem, 3.4vw, 3.5rem);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.research-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(28px, 3.4vw, 54px);
	}

	.research-area {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding-top: 18px;
		border-top: 1px solid #c9cacf;
	}

	.research-image {
		width: min(100%, 440px);
		aspect-ratio: 1 / 1;
		margin: 0 auto 30px;
		border-radius: 50%;
		overflow: hidden;
	}

	.research-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 220ms ease;
	}

	.research-area:hover .research-image img {
		transform: scale(1.015);
	}

	.research-area h3 {
		min-height: 2.4em;
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.45rem, 1.8vw, 1.85rem);
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.research-area > p {
		margin: 18px 0 24px;
		color: #555a63;
		font-family: inherit;
		font-size: var(--text-body);
		font-weight: 400;
		line-height: var(--body-line-height);
	}

	.research-area > a {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		align-self: flex-start;
		margin-top: auto;
		padding-bottom: 5px;
		border-bottom: 1px solid #c99700;
		font-size: 0.84rem;
		font-weight: 650;
		text-decoration: none;
	}

	.research-area > a span {
		transition: transform 160ms ease;
	}

	.research-area > a:hover span,
	.research-area > a:focus-visible span {
		transform: translateX(3px);
	}

	.pi {
		padding-block: clamp(64px, 5vw, 76px);
		border-top: 1px solid #dedfe2;
	}

	.pi-inner {
		display: grid;
		grid-template-columns: minmax(0, 40fr) minmax(0, 60fr);
		gap: clamp(40px, 5vw, 72px);
		align-items: center;
	}

	.pi-portrait {
		width: min(100%, 500px);
		margin: 0;
		justify-self: center;
	}

	.pi-portrait img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		object-position: 56% center;
	}

	.pi-profile {
		max-width: 650px;
	}

	.pi-profile h2 {
		margin: 18px 0 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.75rem, 4.6vw, 4.75rem);
		font-weight: 400;
		line-height: 1.03;
		letter-spacing: -0.045em;
	}

	.pi-title {
		margin: 14px 0 0;
		color: #343840;
		font-size: clamp(1.05rem, 1.3vw, 1.2rem);
		font-weight: 600;
	}

	.pi-affiliations {
		max-width: 560px;
		margin-top: 22px;
		padding-top: 18px;
		border-top: 1px solid #dedfe2;
		color: #555a63;
		font-size: 0.98rem;
		line-height: 1.65;
	}

	.pi-affiliations p {
		margin: 0;
	}

	.pi-email {
		margin: 12px 0 0;
		font-size: 0.92rem;
		line-height: 1.5;
	}

	.pi-email a {
		color: #343840;
		text-decoration-color: #c99700;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
		transition: color 160ms ease, text-decoration-color 160ms ease;
	}

	.pi-email a:hover,
	.pi-email a:focus-visible {
		color: #896400;
		text-decoration-color: #896400;
	}

	.pi-link {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		margin-top: 20px;
		padding-bottom: 5px;
		border-bottom: 1px solid #c99700;
		font-size: 0.87rem;
		font-weight: 650;
		text-decoration: none;
	}

	.pi-link span {
		transition: transform 160ms ease;
	}

	.pi-link:hover span,
	.pi-link:focus-visible span {
		transform: translateX(3px);
	}

	.publications {
		padding-block: clamp(64px, 6.5vw, 96px) clamp(72px, 7vw, 104px);
		border-top: 1px solid #dedfe2;
	}

	.publications-inner {
		max-width: 1180px;
	}

	.publications-header {
		display: flex;
		gap: 48px;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: clamp(44px, 5vw, 68px);
	}

	.publications-header h2 {
		margin: 16px 0 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.3rem, 3.4vw, 3.5rem);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.publication-record {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		width: fit-content;
		margin-left: auto;
