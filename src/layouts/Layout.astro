---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Gupta Research Group | UCF',
	description = 'The Gupta Research Group designs low-dimensional materials for next-generation quantum and electronic technologies.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--page-header-padding-block: 68px;
		--page-header-padding-block-mobile: 48px;
		--page-eyebrow-heading-gap: 16px;
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #111318;
		background: #ffffff;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
	}

	a {
		color: inherit;
	}

	a:focus-visible,
	button:focus-visible,
	summary:focus-visible {
		outline: 2px solid #c99700;
		outline-offset: 4px;
	}

	button,
	summary {
		font: inherit;
	}

	.page-eyebrow {
		margin: 0;
		padding: 0;
		color: #896400;
		font-size: 0.74rem;
		font-weight: 750;
		letter-spacing: 0.14em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.page-eyebrow + h1 {
		margin-top: var(--page-eyebrow-heading-gap);
	}
</style>
